OPENAI_API_KEY=your_openai_api_key_here

# ── 本地 Ollama 配置 ──────────────────────────────────────────────────────────
# 取消注释下面几行即可切换到本地 Ollama gemma4 模型

# 图片视觉分析（/vision）
#VISION_PROVIDER=local
#LOCAL_VISION_URL=http://localhost:11434
#LOCAL_VISION_MODEL=gemma4

# Agent 问答 + 滑动窗口摘要（/agent, 自动摘要）
#CHAT_PROVIDER=local
#LOCAL_CHAT_URL=http://localhost:11434
#LOCAL_CHAT_MODEL=gemma4

# 语音转文字（STT）— Ollama 不支持 Whisper，保持 openai 或切换 SenseVoice
#STT_PROVIDER=openai
#STT_PROVIDER=sensevoice
#SENSEVOICE_URL=http://localhost:50000
